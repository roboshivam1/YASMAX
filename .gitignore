# File: .gitignore
# Things git should never track in the YASMAX repo.

# Python caches and packaging leftovers
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# Build output: regenerate with `python3 tools/build_engine.py`
# and `python3 tools/build_site.py` (GitHub Actions builds them to deploy).
web/engine.zip
_site/
dist/

# Editor and OS clutter
.DS_Store
.vscode/
.idea/
